# Copy this file to .env and fill in values before running the server.
# Never commit .env to git.

# vLLM inference server
VLLM_BASE_URL=http://localhost:8001
MODEL_NAME=kinnow-v1

# Redis
REDIS_URL=redis://localhost:6379/0

# API authentication: clients send  Authorization: Bearer <key>
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production the key must be at least 24 characters.
API_KEY_PROD=change-me-local-dev-key
# Optional: a second accepted key while rotating (remove the old one afterwards)
# API_KEY_NEW=

# Domain centroids (built by scripts/build_centroids.py after training data is ready)
CENTROIDS_PATH=data/centroids.npz

# HuggingFace (needed for training scripts only)
HF_TOKEN=hf_your_token_here
HF_REPO=KaraPatelDev/kinnow-v1

# Environment
ENV=development   # development | staging | production
LOG_LEVEL=INFO
