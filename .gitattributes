# Normalize line endings: store LF in the repo, check out native per platform.
* text=auto eol=lf

# Shell scripts must always be LF or they break on Linux runners.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf

# Binary — never touched.
*.png binary
*.jpg binary
*.npy binary
*.safetensors binary
*.gguf binary
